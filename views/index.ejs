<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Student Registration Portal</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Bootstrap CDN for responsive design -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">
  
</head>
<body class="bg-light" >
  <div class="container py-4">
    <h1 class="mb-3" >Student Registration Portal</h1>
    <div class="row">
      <!-- Form column -->
      <div class="col-md-6">
        <div class="card p-3 mb-3" >
          <h5>Register Student</h5>
          <!-- inline client-side validation example -->
          <form id="registerForm" action="/submit" method="POST" onsubmit="return validateForm();">
            <input type="text" name="name" id="name" class="form-control my-2" placeholder="Name" required>
            <input type="email" name="email" id="email" class="form-control my-2" placeholder="Email" required>
            <input type="text" name="course" id="course" class="form-control my-2" placeholder="Course" required>
            <input type="text" name="phone" id="phone" class="form-control my-2" placeholder="Phone (optional)">
            <div class="d-flex gap-2 mt-2">
             <button type="submit" class="btn btn-primary" style="background-color: purple; border-color: purple;">Submit</button>
              <button type="button" id="saveApi" class="btn btn-success">Save API's</button>
              <button type="button" id="loadStudents" class="btn btn-outline-secondary" style="background-color: wheat;">Load Students</button>
            </div>
            <small id="formMsg" class="text-danger mt-2 d-block"></small>
          </form>
        </div>
        <div class="card p-3" >
          <h6>Students (from API)</h6>
          <ul id="studentList" class="list-group"></ul>
        </div>
      </div>

      <!-- Preview column -->
      <div class="col-md-6">
        <div class="card p-3">
          <h5>Live Preview</h5>
          <div id="previewCard" class="p-3 border rounded">
            <p id="previewName">Your Name</p>
            <p id="previewCourse">Selected Course: -</p>
            <p id="previewEmail">Email: -</p>
            <p id="previewPhone">Phone: -</p>
          </div>
          <div class="mt-3">
            <h6>How it works</h6>
            <p>Type into the form on the left to see a live preview. Submit to save on the server or post via API.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/public/js/main.js"></script>
</body>
</html>
